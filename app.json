{
  "expo": {
    "name": "SnoozeTax",
    "slug": "snooze-tax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-logo.png",
    "scheme": "snoozetax",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iftsoftware.snoozetax",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "audio"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.703461511477-b6s322d6m0o47p6o6lqda56bs9etlq2p"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.703461511477-b6s322d6m0o47p6o6lqda56bs9etlq2p"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/images/app-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.snoozetax",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#162046",
          "dark": {
            "backgroundColor": "#162046"
          }
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-logo.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sounds/alarm-clock-beep.wav",
            "./assets/sounds/alarm-digital-clock-beep.wav",
            "./assets/sounds/alarm-tone.wav",
            "./assets/sounds/alert.wav",
            "./assets/sounds/battleship.wav",
            "./assets/sounds/casino-jackpot-alarm-and-coins.wav",
            "./assets/sounds/casino-win-alarm-and-coins.wav",
            "./assets/sounds/city-alert-siren-loop.wav",
            "./assets/sounds/classic-short.wav",
            "./assets/sounds/classic-winner.wav",
            "./assets/sounds/classic.wav",
            "./assets/sounds/critical.wav",
            "./assets/sounds/data-scaner.wav",
            "./assets/sounds/digital-clock-digital-alarm-buzzer.wav",
            "./assets/sounds/emergency-alert-alarm.wav",
            "./assets/sounds/facility-alarm-sound.wav",
            "./assets/sounds/facility.wav",
            "./assets/sounds/game-notification-wave.wav",
            "./assets/sounds/interface-hint-notification.wav",
            "./assets/sounds/morning-clock.wav",
            "./assets/sounds/retro-game-emergency.wav",
            "./assets/sounds/rooster-crowing-in-the-morning.wav",
            "./assets/sounds/scanning-sci-fi.wav",
            "./assets/sounds/security-facility-breach.wav",
            "./assets/sounds/short-rooster-crowing.wav",
            "./assets/sounds/slot-machine-payout.wav",
            "./assets/sounds/slot-machine-win.wav",
            "./assets/sounds/sound-alert-in-hall.wav",
            "./assets/sounds/space-shooter.wav",
            "./assets/sounds/spaceship.wav",
            "./assets/sounds/street-public.wav",
            "./assets/sounds/vintage-warning.wav",
            "./assets/sounds/warning-alarm-buzzer.wav"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20d58f8e-6943-47a5-accc-5d3f6db30fcc"
      }
    }
  }
}
